{
  "name": "arsenale",
  "version": "1.4.0",
  "description": "Hire agents. Watch them work. Stay in charge. A local dashboard and run log for any coding agent.",
  "license": "MIT",
  "author": "Emad Barandan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emadbarandan/Arsenale-Ai-Agent-Company.git"
  },
  "homepage": "https://github.com/emadbarandan/Arsenale-Ai-Agent-Company#readme",
  "bugs": "https://github.com/emadbarandan/Arsenale-Ai-Agent-Company/issues",
  "keywords": ["ai-agents", "dashboard", "coding-agents", "observability", "mcp", "mcp-server", "claude-code", "codex", "gemini-cli", "cursor", "aider"],
  "bin": {
    "arsenale": "bin/arsenale.cjs"
  },
  "files": [
    "bin/",
    "tools/*.cjs",
    "tools/pages/",
    "tools/model-prices.json",
    "tools/price-defaults.json",
    "tools/OFFICE-WORLD-NOTE.md",
    "tools/vendor/",
    "tools/characters/",
    "!tools/characters/build-sprites.cjs",
    "!tools/characters/build-characters.cjs",
    "agents/",
    "autonomous/",
    "adapters/",
    "packs/",
    "docs/guide/src/",
    "docs/screenshots/",
    "docs/media/*.png",
    "docs/brand/*.svg",
    "company.example/",
    "install.ps1",
    "install.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/arsenale.cjs serve",
    "demo": "node bin/arsenale.cjs demo",
    "test": "node tools/test/run.cjs fast",
    "test:ui": "node tools/test/run.cjs ui",
    "test:all": "node tools/test/run.cjs all",
    "setup-hooks": "node tools/setup-hooks.cjs"
  }
}
