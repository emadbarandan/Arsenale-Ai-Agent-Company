{
  "name": "arsenale",
  "version": "1.0.0",
  "description": "Run a company of AI agents you can watch at work: a local dashboard and run log for any coding agent.",
  "license": "MIT",
  "author": "Emad Barandan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emadbarandan/Arsenale.git"
  },
